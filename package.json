{
  "name": "@fazibear/pish",
  "version": "0.8.5",
  "type": "module",
  "description": "Shell-inspired prompt UI for pi",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "pi-agent",
    "theme"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fazibear/pish.git"
  },
  "pi": {
    "image": "https://github.com/fazibear/pish/raw/main/assets/screenshot.png",
    "extensions": [
      "./src/index.js"
    ]
  },
  "homepage": "https://github.com/fazibear/pish",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "validate": "node scripts/check-syntax.js",
    "check": "npm run lint && npm run validate && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2"
  }
}
